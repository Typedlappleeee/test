# ── Telegram ────────────────────────────────────────────────────────────────
# api_id / api_hash : https://my.telegram.org → API development tools.
# Ce sont TES identifiants d'application, pas ceux d'un bot.
TG_API_ID=
TG_API_HASH=
# Généré par `npm run login` — chaîne longue, à traiter comme un mot de passe :
# elle donne un accès complet à ton compte Telegram.
TG_SESSION=

# ── Supabase (mode équipe uniquement — inutile en mode local) ───────────────
SUPABASE_URL=https://fvmkmkspfksscgqyvysl.supabase.co
# Clé SERVICE ROLE (jamais dans l'app cliente : elle contourne les RLS).
SUPABASE_SERVICE_KEY=

# ── Cible ───────────────────────────────────────────────────────────────────
# L'organisation ScaleFlow dans laquelle les annonces atterrissent.
ORG_ID=

# Profondeur maximale du rattrapage, par salon. Le parcours s'arrête de lui-même
# dès qu'il retombe sur des annonces déjà connues : une valeur large ne coûte donc
# rien au quotidien, et sert après plusieurs jours sans avoir lancé le worker.
BACKFILL_LIMIT=600
